# Copy to .env and replace these values. Do not commit your .env.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://mfapis:replace-with-a-local-password@localhost:5432/mfapis

# YOUR OWN FX API. Set the private ingestion key only on the server.
# Generate a random key: openssl rand -hex 32
MFAPIS_INGEST_KEY=
# NEVER set true without permission to publicly display the source quotes.
FX_LIVE_DISPLAY_AUTHORIZED=false
FX_REFRESH_SECONDS=15
FX_MAX_QUOTE_AGE_SECONDS=120
AUTO_REFRESH_HISTORY=true
# Optional: allowed direct quote pairs. Inverse and compatible cross rates are calculated by MFAPIs.
# FX_ALLOWED_PAIRS=EUR/USD,USD/INR,GBP/USD,USD/JPY
